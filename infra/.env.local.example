# Local development environment — copy to infra/.env.local and fill in values
# All variables are prefixed AUDIT_ (pydantic-settings env_prefix)

# ── Application ───────────────────────────────────────────────────────────
AUDIT_ENV=local
AUDIT_SECRET_KEY=dev-secret-key-change-in-production-must-be-32c

# ── Database (audit schema — read-write) ────────────────────────────────────
AUDIT_DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/verigence

# ── Database (DI shared — read-only) ──────────────────────────────────────
AUDIT_DI_DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/verigence

# ── Webhook (set this in DI as DI_AUDIT_SERVICE_WEBHOOK_URL) ─────────────────
AUDIT_WEBHOOK_SECRET=local-dev-secret

# ── Auth (leave empty in local — mock tokens are accepted) ──────────────────
AUDIT_SECURITY_JWKS_URL=

# ── Logging ────────────────────────────────────────────────────────────
AUDIT_LOG_LEVEL=DEBUG
AUDIT_LOG_STDOUT=true
AUDIT_LOG_AXIOM=false

# ── Scheduler ──────────────────────────────────────────────────────────
AUDIT_BATCH_HOUR=2

# ── Sentry (optional) ─────────────────────────────────────────────────────
# AUDIT_SENTRY_DSN=https://...

# ── Quick-start commands ────────────────────────────────────────────────────
#
#   1. Install:   cd backend && pip install -e ".[dev]"
#   2. Migrate:   cd backend && alembic upgrade head
#   3. Run:       uvicorn verigence.audit.main:create_app --factory --reload
#   4. Test:      pytest
#   5. Webhook:   curl -X POST http://localhost:8000/internal/trigger \
#                   -H "X-Webhook-Secret: local-dev-secret" \
#                   -H "Content-Type: application/json" \
#                   -d '{"tenant_id":"t1","subject_id":"<uuid>","doc_type_key":"booking_docket"}'
#   6. Full audit: curl -X POST http://localhost:8000/v1/tenants/t1/subjects/<uuid>/audit \
#                    -H "Authorization: Bearer mock.t1.admin.TENANT_ADMIN"
