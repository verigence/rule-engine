# Local development environment — copy to infra/.env.local and fill in values
# Runtime settings use the existing AUDIT_ pydantic-settings prefix.

# ── Application ───────────────────────────────────────────────────────────
AUDIT_ENV=local
AUDIT_SECRET_KEY=dev-secret-key-change-in-production-must-be-32c

# ── Database (rule-engine schema — read-write) ─────────────────────────────
AUDIT_DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/verigence

# ── Database (DI shared — read-only) ──────────────────────────────────────
AUDIT_DI_DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/verigence

# ── Webhook ────────────────────────────────────────────────────────────────
AUDIT_WEBHOOK_SECRET=local-dev-secret

# ── Auth ──────────────────────────────────────────────────────────────────
AUDIT_SECURITY_JWKS_URL=

# ── Local structured logging ───────────────────────────────────────────────
AUDIT_LOG_LEVEL=DEBUG
AUDIT_LOG_STDOUT=true

# ── Independent OTLP/Axiom observability capabilities ─────────────────────
# All are opt-in. Tracing remains off unless explicitly enabled and therefore
# does not initialize FastAPI/HTTPX/SQLAlchemy trace instrumentation by default.
AUDIT_OBSERVABILITY_LOGS_ENABLED=false
AUDIT_OBSERVABILITY_ERRORS_ENABLED=false
AUDIT_OBSERVABILITY_METRICS_ENABLED=false
AUDIT_OBSERVABILITY_TRACES_ENABLED=false
AUDIT_OBSERVABILITY_SERVICE_NAME=verigence-rule-engine
AUDIT_OBSERVABILITY_EXPORT_TIMEOUT_SECONDS=2
AUDIT_OBSERVABILITY_BATCH_DELAY_MS=1000
AUDIT_OBSERVABILITY_MAX_QUEUE_SIZE=2048
AUDIT_OBSERVABILITY_MAX_EXPORT_BATCH_SIZE=512
AUDIT_OBSERVABILITY_METRIC_EXPORT_INTERVAL_MS=60000

# Standard OTLP/HTTP configuration; do not commit real tokens.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://api.axiom.co/v1/logs
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=Authorization=Bearer <token>,x-axiom-dataset=verigence-logs
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://api.axiom.co/v1/metrics
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=Authorization=Bearer <token>,x-axiom-metrics-dataset=verigence-metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.axiom.co/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer <token>,x-axiom-dataset=verigence-traces

# Deprecated direct Axiom drain variables; retained only for compatibility.
AUDIT_LOG_AXIOM=false
# AUDIT_AXIOM_TOKEN=
# AUDIT_AXIOM_DATASET=verigence-audit

# ── Scheduler ──────────────────────────────────────────────────────────────
AUDIT_BATCH_HOUR=2

# ── Sentry (optional) ─────────────────────────────────────────────────────
# AUDIT_SENTRY_DSN=https://...

# ── Quick-start ────────────────────────────────────────────────────────────
# cd backend && pip install -e ".[dev]"
# cd backend && alembic upgrade head
# uvicorn verigence.audit.main:create_app --factory --reload
# pytest
